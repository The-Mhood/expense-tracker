# Database connection string. SQLAlchemy URL format: dialect+driver://user:pass@host:port/dbname
#
# Local (Homebrew Postgres on macOS):
#   DATABASE_URL=postgresql+psycopg2://<your-macos-username>@localhost:5432/expenses
#
# Neon (cloud Postgres):
#   Neon gives you a URL that starts with postgresql://. You can use it with either
#   driver. The psycopg (v3) driver is recommended for Neon/SQLAlchemy 2.0+:
#     postgresql+psycopg://user:pwd@ep-xxx.<region>.aws.neon.tech/dbname?sslmode=require
#   Or with psycopg2:
#     postgresql+psycopg2://user:pwd@ep-xxx.<region>.aws.neon.tech/dbname?sslmode=require
#   Make sure ?sslmode=require is appended — Neon requires SSL.
DATABASE_URL=postgresql+psycopg2://mhoodpc@localhost:5432/expenses

# CORS allowed origins (comma-separated list).
# Local dev: http://localhost:3000
# Production: your Vercel/Cloudflare URL(s). Example:
#   CORS_ORIGINS=https://expenses.yourdomain.com,https://your-project.vercel.app
CORS_ORIGINS=http://localhost:3000
